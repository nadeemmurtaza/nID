# Postgres connection used for migrations and the seed script — the "nid"
# role is the Postgres superuser created by the official postgres image via
# POSTGRES_USER, so it always bypasses Row-Level Security regardless of
# FORCE. Never point apps/api at this URL.
DATABASE_URL="postgresql://nid:nid@localhost:5432/nid?schema=public"

# Postgres connection used by apps/api at runtime. "nid_app" is a
# least-privilege role with no BYPASSRLS (created by
# packages/db/sql/001-app-role-bootstrap.sql), so every tenant-owned table's
# RLS policy actually applies to it — see packages/db/prisma/migrations/000_init.
APP_DATABASE_URL="postgresql://nid_app:nid_app@localhost:5432/nid?schema=public"

# Temporal server address, consumed by apps/api (client) and apps/workflows (worker)
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="nid-verification"

# apps/api
API_PORT=4000
# Base URL of apps/verify-ui — used to build the hostedUrl returned from
# POST /v1/verification-cases (where a tenant redirects a subject).
VERIFY_UI_URL="http://localhost:3100"
# How long a VerificationSession token is valid for.
SESSION_TTL_MINUTES=60

# apps/verify-ui and apps/dashboard — both call apps/api directly from the browser.
NEXT_PUBLIC_NID_API_URL="http://localhost:4000"

# Verification methods enabled in this environment, comma-separated allowlist.
# Each key must have a matching provider in packages/verification-providers/src/registry.ts.
VERIFICATION_METHODS="otp_sms,document_ocr,liveness,dob_document,education_document,employment_document,education_registry,employment_registry,bank_account_title,estamp_registry,ecp_voter_registration,org_membership,agent_in_person_document,address_gps_match,address_utility_bill,address_postal_otp"

# otp_sms provider (dev): when true, the OTP code is logged instead of sent via a real
# SMS vendor, and returned in API responses for local testing only. Never enable in prod.
OTP_SMS_DEV_MODE=true

# document_ocr / liveness providers (dev): when true, uploaded document/selfie images get
# a mocked OCR/liveness result instead of calling a real vendor. Never enable in prod.
DOCUMENT_OCR_DEV_MODE=true
LIVENESS_DEV_MODE=true
ADDRESS_POSTAL_OTP_DEV_MODE=true
ADDRESS_POSTAL_OTP_API_URL=""
ADDRESS_POSTAL_OTP_API_KEY=""
ADDRESS_GPS_MATCH_MAX_DISTANCE_METERS=""

# dob_document / education_document / employment_document providers (dev): same
# mechanism as document_ocr (real interface, mocked result), one shared toggle.
CLAIM_DOCUMENT_DEV_MODE=true

# education_registry / employment_registry providers (dev): mocked, since no real
# registry/employer vendor is wired up for either ClaimType yet.
REGISTRY_CHECK_DEV_MODE=true

# Real (non-mocked) document_ocr/dob_document/education_document/employment_document
# checks (@nid/ocr-engine, Tesseract): trained-language-data mirror to fetch from,
# since the library's jsdelivr default is blocked by some networks' egress policy.
# Downloaded once per worker process and cached after that. Leave unset to use
# tesseract.js's own default (jsdelivr).
OCR_LANG_DATA_URL="https://tessdata.projectnaptha.com/4.0.0"

# Real (non-mocked) registry checks: a generic HTTP contract this codebase
# defines itself — POST {url} with {method, referenceId, subjectId, tenantId},
# Bearer {key}, expects {status, score?, raw?} back. No self-serve vendor
# exists for any of these (National Student Clearinghouse / Truework / a
# provincial Pakistani e-stamping authority or bank all require an actual
# agreement) — point these at whichever vendor/aggregator you've contracted
# with, or a thin adapter in front of it. Ignored while
# REGISTRY_CHECK_DEV_MODE=true. See RegistryCheckProvider's header comment.
EDUCATION_REGISTRY_API_URL=""
EDUCATION_REGISTRY_API_KEY=""
EMPLOYMENT_REGISTRY_API_URL=""
EMPLOYMENT_REGISTRY_API_KEY=""
BANK_ACCOUNT_TITLE_API_URL=""
BANK_ACCOUNT_TITLE_API_KEY=""
# estamp_registry: CNIC (referenceId) + phone — whichever province's
# e-stamping authority/bank you've actually contracted with (Punjab's runs
# through Bank of Punjab; other provinces run their own — this is a
# devolved, per-province system with no single national vendor).
ESTAMP_REGISTRY_API_URL=""
ESTAMP_REGISTRY_API_KEY=""

# Where uploaded document/selfie bytes are written by the local-disk StorageDriver
# (@nid/storage). Must be an ABSOLUTE path: apps/api and apps/workflows run with
# different working directories (apps/api, apps/workflows), so a relative path would
# resolve to two different directories and apps/workflows could never read back what
# apps/api just wrote. Fine for one host, which is all local-disk storage is meant for —
# see @nid/storage's header comment.
LOCAL_STORAGE_DIR="/tmp/nid-storage-data"

# S3-compatible object storage — documented future work for beyond a single host, not
# wired up yet. Placeholder here so the env shape is stable across phases.
DOCUMENT_STORAGE_BUCKET=""
DOCUMENT_STORAGE_KMS_KEY_ID=""
