{
  "name": "nid",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* typecheck",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/* test",
    "lint": "pnpm -r --filter=./packages/* --filter=./apps/* lint",
    "db:validate": "pnpm --filter @nid/db validate",
    "db:migrate": "pnpm --filter @nid/db migrate",
    "db:seed": "pnpm --filter @nid/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript-eslint": "^8.70.0"
  }
}
